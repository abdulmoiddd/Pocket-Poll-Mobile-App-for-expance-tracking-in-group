{
  "expo": {
    "name": "PocketPool",
    "slug": "pocketpool",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#5A48D6"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pocketpool.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "PocketPool requires Face ID to secure your financial data."
      }
    },
    "android": {
      "package": "com.pocketpool.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#5A48D6"
      },
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-local-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "PocketPool accesses photos to let you attach receipt images to expenses.",
          "cameraPermission": "PocketPool accesses the camera to take pictures of expense receipts."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "ede9c994-3b47-43bd-9a00-8bb292c008b5"
      }
    }
  }
}
